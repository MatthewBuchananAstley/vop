# Uitvoerbare scripts/programma's
# Zorg ervoor dat deze bestanden uitvoerbaar zijn (chmod +x) voordat je het pakket bouwt.
# Aanname: 'vop' is het hoofdprogramma
vop usr/bin/
vop.py usr/bin/
pw usr/bin/
t3 usr/bin/
t3.py usr/bin/
Chi-square_test.py usr/bin/
Kolmogorov-Smirnov-test.py usr/bin/
Password_entropy_verifier.py usr/bin/
shannon_entropy.py usr/bin/

